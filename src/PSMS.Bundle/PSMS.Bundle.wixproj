<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>PSMS-Setup</OutputName>
    <Version>1.0.0</Version>
    <DefineConstants>ProductVersion=$(Version)</DefineConstants>
    <!-- Downloaded by build-msi.ps1 before building the bundle -->
    <AspNetRuntimePath>$(MSBuildThisFileDirectory)..\..\redist\aspnetcore-runtime-win-x64.exe</AspNetRuntimePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Netfx.wixext" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PSMS.Installer\PSMS.Installer.wixproj" />
  </ItemGroup>

  <!-- Fail early with a clear message if the runtime redistributable is missing -->
  <Target Name="EnsureAspNetRuntimeRedist" BeforeTargets="BeforeBuild">
    <Error
      Condition="!Exists('$(AspNetRuntimePath)')"
      Text="Missing $(AspNetRuntimePath). Run build-msi.ps1 (it downloads the ASP.NET Core 10 x64 runtime) or place aspnetcore-runtime-win-x64.exe in redist\." />
  </Target>

</Project>

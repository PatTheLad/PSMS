@inject ActiveSessionService Sessions
@inject QueryRunner QueryRunner
@inject IConnectionStore Store
@inject IDbProviderFactory ProviderFactory
@inject IFileDialogService FileDialogs
@inject EditorRegistry Editors
@inject SchemaIntelliSenseService IntelliSense
@inject IntelliSenseJsBridge IntelliSenseJs
@inject ContextMenuService Menus
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject UiLayoutStore LayoutStore
@inject SessionStore SessionStore
@inject AppUpdateService Updates
@inject PhotinoHost Photino
@using PSMS.Core.Storage
@using PSMS.Core.Sql
@implements IDisposable
@implements IAsyncDisposable

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
<div class="psms-root" @onkeydown="OnKeyDown" tabindex="0" @onclick="Menus.Close">
    <div class="psms-shell">
        <MudAppBar Elevation="0" Dense="true" Fixed="false" Class="psms-toolbar" Gutters="true">
            <MudText Typo="Typo.subtitle1" Class="psms-brand">PSMS</MudText>

            <MudMenu Label="File" Variant="Variant.Text" Size="Size.Small" Dense="true"
                     EndIcon="@Icons.Material.Filled.ArrowDropDown"
                     Class="psms-toolbar-menu"
                     AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                <MudMenuItem Icon="@Icons.Material.Filled.AddLink" OnClick="OpenNewConnection">New connection</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.NoteAdd" OnClick="NewQueryAsync">New query <span class="psms-menu-hint">⌘/Ctrl+N</span></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.FolderOpen" OnClick="OpenSqlAsync">Open… <span class="psms-menu-hint">⌘/Ctrl+O</span></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Save" OnClick="SaveSqlAsync">Save <span class="psms-menu-hint">⌘/Ctrl+S</span></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.SaveAs" OnClick="SaveSqlAsAsync">Save As…</MudMenuItem>
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Filled.ContentCopy" OnClick="DuplicateTab">Duplicate tab</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.LinkOff" OnClick="DisconnectAsync">Disconnect</MudMenuItem>
            </MudMenu>

            <MudMenu Label="Query" Variant="Variant.Text" Size="Size.Small" Dense="true"
                     EndIcon="@Icons.Material.Filled.ArrowDropDown"
                     Class="psms-toolbar-menu"
                     AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                <MudMenuItem Icon="@Icons.Material.Filled.PlayArrow" Disabled="@(!CanExecute)" OnClick="ExecuteAsync">Execute <span class="psms-menu-hint">F5</span></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Stop" Disabled="@(!CanCancel)" OnClick="Cancel">Cancel <span class="psms-menu-hint">Esc</span></MudMenuItem>
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Filled.AutoFixHigh" OnClick="FormatSqlAsync">Format SQL <span class="psms-menu-hint">Ctrl+Shift+F</span></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.AccountTree" Disabled="@(!CanExecute)" OnClick="EstimatedPlanAsync">Estimated plan <span class="psms-menu-hint">Ctrl+L</span></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.AccountTree" Disabled="@(!CanExecute)" OnClick="ActualPlanAsync">Actual plan <span class="psms-menu-hint">Ctrl+Shift+L</span></MudMenuItem>
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Filled.ManageSearch" OnClick="OpenSuggest">Insert object <span class="psms-menu-hint">Ctrl+Space</span></MudMenuItem>
            </MudMenu>

            <MudMenu Label="Tools" Variant="Variant.Text" Size="Size.Small" Dense="true"
                     EndIcon="@Icons.Material.Filled.ArrowDropDown"
                     Class="psms-toolbar-menu"
                     AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                <MudMenuItem Icon="@Icons.Material.Filled.Terminal" OnClick="OpenPaletteAsync">Command palette <span class="psms-menu-hint">Ctrl+Shift+P</span></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.History" OnClick="OpenHistoryAsync">Query history <span class="psms-menu-hint">Ctrl+H</span></MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Bookmark" OnClick="OpenSnippetsAsync">Snippets</MudMenuItem>
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Filled.AutoAwesome" OnClick="RefreshIntelliSenseAsync">Refresh IntelliSense</MudMenuItem>
            </MudMenu>

            <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />

            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.NoteAdd" OnClick="NewQueryAsync">New query</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="OpenSqlAsync">Open</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSqlAsync">Save</MudButton>
            <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
            <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" StartIcon="@(CanCancel ? null : Icons.Material.Filled.PlayArrow)"
                       Disabled="@(!CanExecute)" OnClick="ExecuteAsync">
                @if (CanCancel)
                {
                    <span class="psms-spinner psms-spinner-sm" style="margin-right:0.4rem;border-top-color:#fff" aria-hidden="true"></span>
                    <text>Running...</text>
                }
                else
                {
                    <text>Execute</text>
                }
            </MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop"
                       Disabled="@(!CanCancel)" OnClick="Cancel">Cancel</MudButton>
            <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
            <MudButton Variant="@(Sessions.ShowAdminWorkspace ? Variant.Filled : Variant.Text)"
                       Size="Size.Small" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.AdminPanelSettings"
                       OnClick="ToggleAdmin">Admin</MudButton>

            <MudSpacer />
            @if (Updates.Available is { } update)
            {
                <MudTooltip Text="@(Updates.IsInstalling
                                   ? $"Updating to {update.Version}…"
                                   : $"Update to {update.Version} (quiet install)")">
                    <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.SystemUpdateAlt"
                               Disabled="@Updates.IsInstalling"
                               OnClick="InstallUpdateAsync"
                               Class="psms-update-btn mr-1">
                        @if (Updates.IsInstalling)
                        {
                            <span class="psms-spinner psms-spinner-sm" style="margin-right:0.35rem;border-top-color:#fff" aria-hidden="true"></span>
                            <span class="psms-update-label">@($"{Updates.InstallProgress:0}%")</span>
                        }
                        else
                        {
                            <span class="psms-update-label">Update</span>
                        }
                    </MudButton>
                </MudTooltip>
            }
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="psms-engine-chip">@EngineLabel</MudChip>
        </MudAppBar>

        <div class="psms-body">
            <aside class="psms-explorer">
                <ObjectExplorer @ref="_explorer"
                                OnOpenQuery="HandleOpenQuery"
                                OnEditTopN="HandleEditTopNAsync"
                                OnEditConnection="EditConnection"
                                OnRequestNewConnection="OpenNewConnection" />
            </aside>
            <div class="psms-vsplit @( _draggingExplorer ? "active" : null )"
                 @onmousedown="StartExplorerDrag"></div>
            <section class="psms-main @(Sessions.ShowAdminWorkspace ? "psms-main-admin" : null)">
                @* Keep query/results mounted so Admin toggle does not wipe editors *@
                <div class="psms-main-queries @(Sessions.ShowAdminWorkspace ? "psms-hidden" : null)">
                    <QueryWorkspace @ref="_workspace" />
                    <div class="psms-hsplit @( _draggingEditor ? "active" : null )"
                         @onmousedown="StartEditorDrag"></div>
                    <ResultsPane @ref="_results" />
                </div>
                @if (Sessions.ShowAdminWorkspace)
                {
                    <AdminWorkspace />
                }
            </section>
        </div>

        <StatusBar />
    </div>

    <AppContextMenu />
    <ObjectSuggestPopup @ref="_suggest" />
    <CommandPalette @ref="_palette"
                    OnRequestExecute="ExecuteAsync"
                    OnRequestCancel="Cancel"
                    OnRequestNewQuery="NewQueryAsync"
                    OnRequestSave="SaveSqlAsync"
                    OnRequestOpen="OpenSqlAsync"
                    OnRequestNewConnection="OpenNewConnection"
                    OnRequestSuggest="OpenSuggest"
                    OnRequestAdmin="ToggleAdmin"
                    OnRequestRefreshCatalog="RefreshIntelliSenseAsync"
                    OnRequestFormatSql="FormatSqlAsync"
                    OnRequestPinResults="PinResults"
                    OnRequestHistory="OpenHistoryAsync"
                    OnRequestSnippets="OpenSnippetsAsync"
                    OnRequestDuplicate="DuplicateTab"
                    OnRequestEstimatedPlan="EstimatedPlanAsync"
                    OnRequestActualPlan="ActualPlanAsync"
                    OnRequestCloseTab="CloseActiveTabAsync"
                    OnOpenQuery="HandleOpenQuery" />
</div>
    </ChildContent>
    <ErrorContent Context="ex">
        <div class="psms-crash">
            <h2>Something went wrong</h2>
            <p>@ex.Message</p>
            <pre>@ex.ToString()</pre>
            <button type="button" class="psms-crash-btn" @onclick="RecoverUi">Reload UI</button>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    private QueryWorkspace? _workspace;
    private ResultsPane? _results;
    private ObjectExplorer? _explorer;
    private ObjectSuggestPopup? _suggest;
    private CommandPalette? _palette;
    private ErrorBoundary? _errorBoundary;
    private bool _draggingExplorer;
    private bool _draggingEditor;
    private DotNetObjectReference<App>? _dotNetRef;

    [Inject] private IJSRuntime Js { get; set; } = default!;

    private async Task ApplyLayoutToDomAsync()
    {
        try
        {
            await Js.InvokeVoidAsync(
                "psmsLayout.apply",
                Sessions.ExplorerWidth,
                Sessions.EditorRatio);
        }
        catch
        {
            // script may not be ready yet
        }
    }

    private string EngineLabel
    {
        get
        {
            if (Sessions.SelectedConnection is { } sel)
            {
                return sel.Engine.ToString();
            }

            if (Sessions.ActiveTab is { } tab)
            {
                var conn = Sessions.OpenConnections.FirstOrDefault(c => c.Id == tab.ConnectionId);
                if (conn is not null)
                {
                    return conn.Engine.ToString();
                }
            }

            return "PSMS";
        }
    }

    private bool CanExecute => Sessions.ActiveTab is not null && !Sessions.ActiveTab.IsExecuting;
    private bool CanCancel => Sessions.ActiveTab?.IsExecuting == true;

    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#3b9eff",
            Secondary = "#38bdf8",
            Background = "#0b0f14",
            Surface = "#12181f",
            AppbarBackground = "#12181f",
            DrawerBackground = "#12181f",
            TextPrimary = "#e8eef6",
            TextSecondary = "#8b9bb0",
            ActionDefault = "#8b9bb0",
            Divider = "#243041",
            LinesDefault = "#243041",
            TableLines = "#243041",
            Error = "#f87171",
            Success = "#34d399",
            Warning = "#fbbf24",
            Info = "#38bdf8"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["IBM Plex Sans", "Segoe UI", "sans-serif"]
            }
        }
    };

    protected override void OnInitialized()
    {
        Sessions.Changed += OnSessionsChanged;
        Updates.Changed += OnUpdatesChanged;
        _ = LoadLayoutAndSessionAsync();
        _ = CheckForUpdatesAsync();
    }

    private void OnUpdatesChanged() => InvokeAsync(StateHasChanged);

    private async Task CheckForUpdatesAsync()
    {
        try
        {
            // Delay so startup / session restore is not competing for the network.
            await Task.Delay(2500);
            await Updates.CheckForUpdatesAsync();
            if (Updates.Available is { } update)
            {
                Snackbar.Add($"PSMS {update.Version} is available.", Severity.Info);
            }
        }
        catch
        {
            // optional feature — ignore
        }
    }

    private async Task InstallUpdateAsync()
    {
        try
        {
            Snackbar.Add("Downloading update… PSMS will restart when finished.", Severity.Info);
            await Updates.DownloadAndInstallAsync();
            if (!string.IsNullOrWhiteSpace(Updates.LastError))
            {
                Snackbar.Add($"Update failed: {Updates.LastError}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Update failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadLayoutAndSessionAsync()
    {
        try
        {
            var layout = await LayoutStore.LoadAsync();
            Sessions.ExplorerWidth = layout.ExplorerWidth;
            Sessions.EditorRatio = layout.EditorRatio;
            await ApplyLayoutToDomAsync();

            var snap = await SessionStore.LoadAsync();
            if (snap.Tabs.Count > 0)
            {
                var known = (await Store.GetAllAsync()).Select(c => c.Id).ToHashSet();
                var tabs = snap.Tabs
                    .Where(t => known.Contains(t.ConnectionId))
                    .Select(t => new QueryTab
                    {
                        // Id is get-only — recreate with same content; new Guids are fine
                        Title = t.Title,
                        ConnectionId = t.ConnectionId,
                        Database = t.Database,
                        Sql = t.Sql,
                        FilePath = t.FilePath,
                        IsDirty = t.IsDirty
                    })
                    .ToList();

                // Preserve active by matching title+connection when ids differ
                Guid? active = null;
                if (snap.ActiveTabId is Guid oldActive)
                {
                    var old = snap.Tabs.FirstOrDefault(t => t.Id == oldActive);
                    if (old is not null)
                    {
                        var match = tabs.FirstOrDefault(t =>
                            t.ConnectionId == old.ConnectionId
                            && t.Database == old.Database
                            && t.Title == old.Title);
                        active = match?.Id;
                    }
                }

                if (tabs.Count > 0)
                {
                    Sessions.RestoreTabs(tabs, active);
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // keep defaults
        }
    }

    private void ScheduleSessionSave()
    {
        SessionStore.ScheduleSave(() => new SessionSnapshot
        {
            ActiveTabId = Sessions.ActiveTabId,
            Tabs = Sessions.Tabs.Select(t => new SessionTabSnapshot
            {
                Id = t.Id,
                ConnectionId = t.ConnectionId,
                Database = t.Database,
                Sql = t.Sql,
                Title = t.Title,
                FilePath = t.FilePath,
                IsDirty = t.IsDirty
            }).ToList()
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            // Bind JS to this component's sync context — never call JS from background threads.
            IntelliSenseJs.Bind(Js, InvokeAsync);
            try
            {
                await Js.InvokeVoidAsync("psmsShortcuts.bind", _dotNetRef);
            }
            catch
            {
                // script may not be ready yet
            }

            await ApplyLayoutToDomAsync();
        }
    }

    /// <summary>Invoked from capture-phase JS so F5/Ctrl+Enter run the query instead of reloading the WebView.</summary>
    [JSInvokable]
    public async Task OnShortcutExecute()
    {
        if (Sessions.ShowAdminWorkspace || Sessions.ActiveTab is null)
        {
            return;
        }

        await ExecuteAsync();
    }

    /// <summary>Cmd+Q (macOS) / Win+Q (Windows) — quit the app.</summary>
    [JSInvokable]
    public void OnShortcutQuit() => QuitApp();

    private void QuitApp()
    {
        try
        {
            Photino.Window?.Close();
        }
        catch
        {
            // ignored
        }

        // Ensure process exits even if the native close event is delayed.
        System.Environment.Exit(0);
    }

    private void OnSessionsChanged()
    {
        _ = FlushAndSaveSessionAsync();
        InvokeAsync(StateHasChanged);
    }

    private async Task FlushAndSaveSessionAsync()
    {
        try
        {
            if (Sessions.ActiveTab is { } tab)
            {
                tab.Sql = await Editors.GetSqlAsync(tab.Id) ?? tab.Sql;
            }
        }
        catch
        {
            // editor may not be ready
        }

        ScheduleSessionSave();
    }

    private void RecoverUi() => _errorBoundary?.Recover();

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        // Never hijack clipboard / select-all — especially important on macOS (Cmd+C/V/X/A).
        if ((e.CtrlKey || e.MetaKey) && !e.AltKey && !e.ShiftKey
            && (e.Key.Equals("c", StringComparison.OrdinalIgnoreCase)
                || e.Key.Equals("v", StringComparison.OrdinalIgnoreCase)
                || e.Key.Equals("x", StringComparison.OrdinalIgnoreCase)
                || e.Key.Equals("a", StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        if ((e.CtrlKey || e.MetaKey) && e.ShiftKey && e.Key.Equals("p", StringComparison.OrdinalIgnoreCase))
        {
            await OpenPaletteAsync();
            return;
        }

        if ((e.CtrlKey || e.MetaKey) && e.Key.Equals("h", StringComparison.OrdinalIgnoreCase) && !e.ShiftKey)
        {
            await OpenHistoryAsync();
            return;
        }

        if ((e.CtrlKey || e.MetaKey) && e.Key.Equals("f", StringComparison.OrdinalIgnoreCase) && !e.ShiftKey)
        {
            try
            {
                if (await Js.InvokeAsync<bool>("psmsIsMonacoFocused"))
                {
                    return;
                }
            }
            catch
            {
                // fall through to results filter
            }

            if (_results is not null)
            {
                await _results.FocusFilterAsync();
            }

            return;
        }

        if ((e.CtrlKey || e.MetaKey) && e.Key.Equals("w", StringComparison.OrdinalIgnoreCase) && !e.ShiftKey)
        {
            await CloseActiveTabAsync();
            return;
        }

        if ((e.CtrlKey || e.MetaKey) && e.Key.Equals("Tab", StringComparison.OrdinalIgnoreCase))
        {
            Sessions.CycleTab(e.ShiftKey ? -1 : 1);
            return;
        }

        if ((e.CtrlKey || e.MetaKey) && e.Key.Equals("k", StringComparison.OrdinalIgnoreCase) && !e.ShiftKey)
        {
            await OpenPaletteAsync();
            return;
        }

        if ((e.CtrlKey || e.MetaKey) && e.ShiftKey && e.Key.Equals("f", StringComparison.OrdinalIgnoreCase))
        {
            await FormatSqlAsync();
            return;
        }

        if ((e.CtrlKey || e.MetaKey) && e.Key.Equals("l", StringComparison.OrdinalIgnoreCase) && !e.ShiftKey)
        {
            await EstimatedPlanAsync();
            return;
        }

        if ((e.CtrlKey || e.MetaKey) && e.ShiftKey && e.Key.Equals("l", StringComparison.OrdinalIgnoreCase))
        {
            await ActualPlanAsync();
            return;
        }

        // F5 / Ctrl+Enter are handled in capture-phase JS (psmsShortcuts) so the WebView
        // cannot reload the page; Blazor may still see bubbled keys when Monaco is not focused.
        if (e.Key == "F5" || ((e.CtrlKey || e.MetaKey) && (e.Key == "Enter" || e.Code == "Enter")))
        {
            if (!Sessions.ShowAdminWorkspace && Sessions.ActiveTab is not null)
            {
                await ExecuteAsync();
            }
        }
        else if (e.CtrlKey && e.Key.Equals(" ", StringComparison.Ordinal))
        {
            // Ctrl+Space only — Cmd+Space is Spotlight on macOS.
            OpenSuggest();
        }
        else if ((e.CtrlKey || e.MetaKey) && e.Key.Equals("n", StringComparison.OrdinalIgnoreCase))
        {
            await NewQueryAsync();
        }
        else if ((e.CtrlKey || e.MetaKey) && e.Key.Equals("s", StringComparison.OrdinalIgnoreCase))
        {
            await SaveSqlAsync();
        }
        else if ((e.CtrlKey || e.MetaKey) && e.Key.Equals("o", StringComparison.OrdinalIgnoreCase))
        {
            await OpenSqlAsync();
        }
        else if (e.MetaKey && !e.CtrlKey && !e.AltKey && !e.ShiftKey
                 && e.Key.Equals("q", StringComparison.OrdinalIgnoreCase))
        {
            QuitApp();
        }
        else if (e.Key == "Escape")
        {
            Menus.Close();
            if (CanCancel)
            {
                Cancel();
            }
        }
    }

    private void OpenSuggest() => _suggest?.Open();

    private Task OpenPaletteAsync() => _palette?.OpenAsync() ?? Task.CompletedTask;

    private async Task OpenHistoryAsync()
    {
        await DialogService.ShowAsync<QueryHistoryDialog>("Query history", new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        });
    }

    private async Task OpenSnippetsAsync()
    {
        await DialogService.ShowAsync<SnippetsDialog>("Saved snippets", new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        });
    }

    private void DuplicateTab()
    {
        if (Sessions.DuplicateActiveTab() is null)
        {
            Snackbar.Add("Nothing to duplicate — open a query tab first.", Severity.Warning);
        }
        else
        {
            Snackbar.Add("Tab duplicated.", Severity.Success);
        }
    }

    private async Task FormatSqlAsync()
    {
        if (_workspace is not null)
        {
            await _workspace.FormatActiveSqlAsync();
        }
    }

    private void PinResults()
    {
        var pin = Sessions.PinCurrentResult();
        Snackbar.Add(pin is null ? "Nothing to pin — run a query first." : "Results pinned.",
            pin is null ? Severity.Warning : Severity.Success);
    }

    private void ToggleAdmin()
    {
        if (Sessions.ShowAdminWorkspace)
        {
            Sessions.ShowQueries();
        }
        else
        {
            Sessions.ShowAdmin();
        }
    }

    private async Task StartExplorerDrag()
    {
        _draggingExplorer = true;
        if (_dotNetRef is not null)
        {
            await Js.InvokeVoidAsync("psmsDrag.start", _dotNetRef, "explorer");
        }
    }

    private async Task StartEditorDrag()
    {
        _draggingEditor = true;
        if (_dotNetRef is not null)
        {
            await Js.InvokeVoidAsync("psmsDrag.start", _dotNetRef, "editor");
        }
    }

    [JSInvokable]
    public void OnDragEnd(string mode, double explorerWidth, double editorRatio)
    {
        if (mode == "explorer")
        {
            Sessions.ExplorerWidth = Math.Clamp(explorerWidth, 220, 480);
        }
        else
        {
            Sessions.EditorRatio = Math.Clamp(editorRatio, 0.2, 0.8);
        }

        _draggingExplorer = false;
        _draggingEditor = false;
        _ = PersistLayoutAsync();
    }

    private async Task PersistLayoutAsync()
    {
        await ApplyLayoutToDomAsync();
        await LayoutStore.SaveAsync(Sessions.ExplorerWidth, Sessions.EditorRatio);
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenNewConnection()
    {
        var parameters = new DialogParameters<ConnectionDialog>
        {
            { x => x.Connection, new ConnectionDefinition() }
        };
        // Reload comes from ConnectionDialog → NotifyConnectionsChanged (avoid double ReloadAsync race).
        await DialogService.ShowAsync<ConnectionDialog>("New connection", parameters);
    }

    private async Task EditConnection(ConnectionDefinition connection)
    {
        var parameters = new DialogParameters<ConnectionDialog>
        {
            { x => x.Connection, Clone(connection) }
        };
        await DialogService.ShowAsync<ConnectionDialog>("Edit connection", parameters);
    }

    private void HandleOpenQuery((ConnectionDefinition Connection, string Database, string? Sql, string? Title) args)
    {
        Sessions.ShowQueries();
        Sessions.OpenQueryTab(args.Connection, args.Database, args.Sql, args.Title);
    }

    private async Task NewQueryAsync()
    {
        var connection = Sessions.SelectedConnection
                         ?? Sessions.OpenConnections.FirstOrDefault()
                         ?? (await Store.GetAllAsync()).FirstOrDefault();

        if (connection is null)
        {
            Snackbar.Add("Create or connect a connection first.", Severity.Warning);
            return;
        }

        var database = Sessions.ActiveTab?.Database
                       ?? connection.Database
                       ?? "master";
        Sessions.OpenQueryTab(connection, database);
        _ = IntelliSense.EnsureAsync(connection, database);
    }

    private async Task RefreshIntelliSenseAsync()
    {
        var tab = Sessions.ActiveTab;
        var connection = tab is not null
            ? Sessions.OpenConnections.FirstOrDefault(c => c.Id == tab.ConnectionId)
              ?? (await Store.GetAllAsync()).FirstOrDefault(c => c.Id == tab.ConnectionId)
            : Sessions.SelectedConnection;

        var database = tab?.Database ?? connection?.Database ?? "master";
        if (connection is null)
        {
            Snackbar.Add("Connect to a server first.", Severity.Warning);
            return;
        }

        Snackbar.Add("Refreshing IntelliSense…", Severity.Info);
        var snap = await IntelliSense.EnsureAsync(connection, database, forceRefresh: true);
        await IntelliSenseJs.PushCurrentAsync();
        if (snap?.Status.StartsWith("Error") == true)
        {
            Snackbar.Add(snap.Status, Severity.Error);
        }
        else
        {
            var msg = $"IntelliSense ready — {snap?.Databases.Count:N0} databases, {snap?.TableCount:N0} tables/views.";
            if (IntelliSenseJs.LastPushTruncated)
            {
                msg += " (JS catalog capped for stability — current DB prioritized.)";
            }

            Snackbar.Add(msg, Severity.Success);
        }
    }

    private async Task OpenSqlAsync()
    {
        var path = await FileDialogs.OpenSqlFileAsync();
        if (string.IsNullOrWhiteSpace(path))
        {
            return;
        }

        var sql = await File.ReadAllTextAsync(path);
        var connection = Sessions.SelectedConnection
                         ?? Sessions.OpenConnections.FirstOrDefault()
                         ?? (await Store.GetAllAsync()).FirstOrDefault();
        if (connection is null)
        {
            Snackbar.Add("Create a connection before opening scripts.", Severity.Warning);
            return;
        }

        var tab = Sessions.OpenQueryTab(connection, connection.Database ?? "master", sql, Path.GetFileName(path));
        tab.FilePath = path;
        tab.IsDirty = false;
        Sessions.Notify();
    }

    private async Task SaveSqlAsync() => await PersistSqlAsync(forceNewPath: false);

    private async Task SaveSqlAsAsync() => await PersistSqlAsync(forceNewPath: true);

    private async Task PersistSqlAsync(bool forceNewPath)
    {
        var tab = Sessions.ActiveTab;
        if (tab is null)
        {
            Snackbar.Add("No active query tab.", Severity.Warning);
            return;
        }

        tab.Sql = await Editors.GetSqlAsync(tab.Id) ?? tab.Sql;
        var path = forceNewPath ? null : tab.FilePath;
        if (string.IsNullOrWhiteSpace(path))
        {
            path = await FileDialogs.SaveSqlFileAsync($"{SanitizeFileName(tab.Title)}.sql");
            if (string.IsNullOrWhiteSpace(path))
            {
                return;
            }

            tab.FilePath = path;
            tab.Title = Path.GetFileName(path);
        }

        await File.WriteAllTextAsync(path, tab.Sql);
        tab.IsDirty = false;
        Sessions.Notify();
        Snackbar.Add($"Saved {path}", Severity.Success);
    }

    private static string SanitizeFileName(string name)
    {
        foreach (var c in Path.GetInvalidFileNameChars())
        {
            name = name.Replace(c, '_');
        }

        return string.IsNullOrWhiteSpace(name) ? "query" : name;
    }


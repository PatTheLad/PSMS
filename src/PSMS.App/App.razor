    private async Task HandleEditTopNAsync((ConnectionDefinition Connection, string Database, string Schema, string Table) args)
    {
        Sessions.ShowQueries();
        var password = args.Connection.UseWindowsAuth ? null : Store.DecryptPassword(args.Connection);
        var provider = ProviderFactory.GetProvider(args.Connection.Engine);

        IReadOnlyList<string> keyCols = [];
        try
        {
            var overview = await provider.GetTableSchemaOverviewAsync(
                args.Connection, password, args.Database, args.Schema, args.Table);
            var pk = overview.Indexes.FirstOrDefault(i => i.IsPrimaryKey);
            if (pk is not null)
            {
                keyCols = pk.Columns.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            }
        }
        catch
        {
            // proceed without keys — WHERE will use all columns
        }

        var sql = BuildEditTopSql(args.Connection.Engine, args.Schema, args.Table, 200);
        var tab = Sessions.OpenQueryTab(
            args.Connection,
            args.Database,
            sql,
            $"Edit {args.Schema}.{args.Table}");

        tab.IsExecuting = true;
        Sessions.ViewLiveResults();
        Sessions.Notify();
        try
        {
            var result = await QueryRunner.ExecuteAsync(args.Connection, args.Database, sql);
            result.EditContext = new EditableResultContext
            {
                ConnectionId = args.Connection.Id,
                Database = args.Database,
                Schema = args.Schema,
                Table = args.Table,
                Engine = args.Connection.Engine,
                KeyColumns = keyCols
            };
            tab.LastResult = result;
            if (!string.IsNullOrEmpty(result.Error))
            {
                Snackbar.Add(result.Error, Severity.Error);
            }
            else
            {
                var hint = keyCols.Count > 0
                    ? $"Edit Top 200 — double-click cells, then Script UPDATEs (PK: {string.Join(", ", keyCols)})."
                    : "Edit Top 200 — no PK found; UPDATEs will match on all column values.";
                Snackbar.Add(hint, Severity.Info);
            }
        }
        catch (Exception ex)
        {
            tab.LastResult = new QueryResult { Error = ex.Message, Messages = [ex.Message] };
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            tab.IsExecuting = false;
            Sessions.Notify();
        }
    }

    private static string BuildEditTopSql(DbEngine engine, string schema, string table, int n)
    {
        var qualified = engine == DbEngine.SqlServer
            ? $"[{schema}].[{table}]"
            : string.IsNullOrWhiteSpace(schema) || schema is "main" or "dbo"
                ? $"\"{table.Replace("\"", "\"\"")}\""
                : $"\"{schema.Replace("\"", "\"\"")}\".\"{table.Replace("\"", "\"\"")}\"";
        return engine switch
        {
            DbEngine.SqlServer => $"SELECT TOP ({n}) *{System.Environment.NewLine}FROM {qualified};",
            _ => $"SELECT *{System.Environment.NewLine}FROM {qualified}{System.Environment.NewLine}LIMIT {n};"
        };
    }

    private void Cancel() => QueryRunner.Cancel();

    private Task DisconnectAsync()
    {
        var id = Sessions.ActiveTab?.ConnectionId ?? Sessions.SelectedConnectionId;
        if (id is Guid connectionId)
        {
            Sessions.MarkDisconnected(connectionId);
            IntelliSense.Invalidate(connectionId);
            Snackbar.Add("Disconnected.", Severity.Info);
        }
        else
        {
            Snackbar.Add("Nothing to disconnect.", Severity.Warning);
        }

        return Task.CompletedTask;
    }

    private static ConnectionDefinition Clone(ConnectionDefinition source) => new()
    {
        Id = source.Id,
        Name = source.Name,
        Engine = source.Engine,
        Server = source.Server,
        Database = source.Database,
        UseWindowsAuth = source.UseWindowsAuth,
        UserName = source.UserName,
        EncryptedPassword = source.EncryptedPassword,
        Encrypt = source.Encrypt,
        TrustServerCertificate = source.TrustServerCertificate,
        Port = source.Port,
        Color = source.Color
    };

    public void Dispose()
    {
        Sessions.Changed -= OnSessionsChanged;
        Updates.Changed -= OnUpdatesChanged;
        try
        {
            _ = Js.InvokeVoidAsync("psmsShortcuts.unbind");
        }
        catch
        {
            // shutting down
        }

        _dotNetRef?.Dispose();
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}

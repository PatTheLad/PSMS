<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Needed so WiX ProjectReference publish (RID=win-x64) finds assets after restore -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PSMS.App</RootNamespace>
    <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyTitle>PSMS</AssemblyTitle>
    <Product>PSMS — SQL Management Studio</Product>
    <Company>PSMS</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlazorMonaco" Version="3.5.0" />
    <PackageReference Include="MudBlazor" Version="9.8.0" />
    <PackageReference Include="PhotinoX.Blazor" Version="5.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PSMS.Core\PSMS.Core.csproj" />
    <ProjectReference Include="..\PSMS.Providers.SqlServer\PSMS.Providers.SqlServer.csproj" />
    <ProjectReference Include="..\PSMS.Providers.Sqlite\PSMS.Providers.Sqlite.csproj" />
    <ProjectReference Include="..\PSMS.Providers.Access\PSMS.Providers.Access.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="wwwroot\appicon.png" LogicalName="PSMS.App.wwwroot.appicon.png" />
    <EmbeddedResource Include="wwwroot\favicon.ico" LogicalName="PSMS.App.wwwroot.favicon.ico" />
  </ItemGroup>

  <!-- Photino looks for icons next to the executable on Linux/KDE -->
  <Target Name="CopyWindowIcons" AfterTargets="Build">
    <Copy SourceFiles="wwwroot\appicon.png;wwwroot\favicon.ico"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>

    private static string VisibleRowLabel(QueryResult result)
    {
        var n = result.ResultSets.Sum(s => s.DisplayRows.Count > 0 ? s.DisplayRows.Count : s.Rows.Count);
        return $"{n:N0} row{(n == 1 ? "" : "s")}";
    }

    private async Task ExportCsvAsync()
    {
        var result = DisplayResult;
        if (result is null || result.ResultSets.Count == 0)
        {
            return;
        }

        var set = result.ResultSets[Math.Clamp(_activePanel, 0, result.ResultSets.Count - 1)];
        var path = await FileDialogs.SaveCsvFileAsync("results.csv");
        if (string.IsNullOrWhiteSpace(path))
        {
            return;
        }

        await File.WriteAllTextAsync(path, ResultMaterializer.BuildCsv(set));
        Snackbar.Add($"Exported to {path}", Severity.Success);
    }

    private async Task ExportJsonAsync()
    {
        var result = DisplayResult;
        if (result is null || _activePanel < 0 || _activePanel >= result.ResultSets.Count)
        {
            return;
        }

        var set = result.ResultSets[_activePanel];
        var rows = GetGridRows(set);
        var path = await FileDialogs.SaveJsonFileAsync("results.json");
        if (string.IsNullOrWhiteSpace(path))
        {
            return;
        }

        var list = new List<Dictionary<string, object?>>(rows.Count);
        foreach (var row in rows)
        {
            var obj = new Dictionary<string, object?>(set.Columns.Count, StringComparer.OrdinalIgnoreCase);
            for (var i = 0; i < set.Columns.Count; i++)
            {
                var name = set.Columns[i];
                var key = name;
                var n = 1;
                while (!obj.TryAdd(key, i < row.Cells.Count ? row.Cells[i] : null))
                {
                    key = $"{name}_{++n}";
                }
            }

            list.Add(obj);
        }

        var json = System.Text.Json.JsonSerializer.Serialize(list, new System.Text.Json.JsonSerializerOptions
        {
            WriteIndented = true
        });
        await File.WriteAllTextAsync(path, json);
        Snackbar.Add($"Exported {rows.Count:N0} row(s) to {path}", Severity.Success);
    }

    private async Task CopyMarkdownAsync()
    {
        var result = DisplayResult;
        if (result is null || _activePanel < 0 || _activePanel >= result.ResultSets.Count)
        {
            return;
        }

        var set = result.ResultSets[_activePanel];
        var rows = GetGridRows(set);
        var take = Math.Min(rows.Count, 2_000);
        var sb = new StringBuilder();
        sb.Append('|').Append(string.Join('|', set.Columns)).Append('|').AppendLine();
        sb.Append('|').Append(string.Join('|', set.Columns.Select(_ => "---"))).Append('|').AppendLine();
        for (var i = 0; i < take; i++)
        {
            var cells = rows[i].Cells.Select(c => EscapeMd(c ?? "NULL"));
            sb.Append('|').Append(string.Join('|', cells)).Append('|').AppendLine();
        }

        if (rows.Count > take)
        {
            sb.AppendLine($"> … {rows.Count - take:N0} more rows omitted");
        }

        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
            Snackbar.Add($"Copied {take:N0} row(s) as Markdown.", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Could not copy to clipboard.", Severity.Warning);
        }
    }

    private static string EscapeMd(string value) =>
        value.Replace("|", "\\|").Replace("\r\n", " ").Replace('\n', ' ').Replace('\r', ' ');

    public void Dispose()
    {
        Sessions.Changed -= OnChanged;
        _resizeRef?.Dispose();
    }

@using PSMS.Core.Models
@using PSMS.Core.Storage
@inject ActiveSessionService Sessions
@inject QueryRunner QueryRunner
@inject IConnectionStore Store
@inject IDbProviderFactory ProviderFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject EditorRegistry Editors
@inject SchemaIntelliSenseService IntelliSense
@inject QueryHistoryStore History
@implements IDisposable

<div class="psms-editor-pane">
    @if (Sessions.Tabs.Count == 0)
    {
        <div class="psms-empty">
            Connect to a server, then use <strong>New Query</strong> or right-click a database / table in Object Explorer.
        </div>
    }
    else
    {
        <div class="psms-tab-tools">
            <MudText Typo="Typo.caption" Class="mr-2 psms-toolbar-label">Database</MudText>
            <MudSelect T="string" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:220px"
                       Value="Sessions.ActiveTab?.Database"
                       ValueChanged="OnDatabaseChanged"
                       Disabled="@(Sessions.ActiveTab is null)">
                @foreach (var db in _databases)
                {
                    <MudSelectItem Value="@db">@db</MudSelectItem>
                }
            </MudSelect>
            <MudTooltip Text="Refresh IntelliSense catalog for this database">
                <MudIconButton Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small"
                               OnClick="RefreshIntelliSenseAsync" aria-label="Refresh IntelliSense" />
            </MudTooltip>
            <MudText Typo="Typo.caption" Class="psms-toolbar-hint">Ctrl+Space</MudText>
            <MudSpacer />
        </div>

        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true"
                 @bind-ActivePanelIndex="_activeIndex"
                 Class="psms-query-tabs"
                 Style="flex:1;min-height:0;height:100%">
            @foreach (var tab in Sessions.Tabs)
            {
                var connection = Sessions.OpenConnections.FirstOrDefault(c => c.Id == tab.ConnectionId);
                var color = connection?.Color;
                <MudTabPanel>
                    <TabContent>
                        <div class="psms-query-tab">
                            @if (!string.IsNullOrWhiteSpace(color))
                            {
                                <span class="psms-tab-color" style="@($"background:{color}")"></span>
                            }
                            <span class="psms-query-tab-title" title="@tab.Title">@(tab.IsDirty ? tab.Title + " *" : tab.Title)</span>
                            <button type="button" class="psms-tab-close" title="Close"
                                    @onclick="@(() => CloseTabAsync(tab.Id))"
                                    @onclick:stopPropagation="true">×</button>
                        </div>
                    </TabContent>
                    <ChildContent>
                        <QueryEditorPane @key="tab.Id" Tab="tab" />
                    </ChildContent>
                </MudTabPanel>
            }
        </MudTabs>
    }
</div>

@code {
    private int _activeIndex;
    private int _lastIndex = -1;
    private List<string> _databases = ["master"];

    protected override void OnInitialized()
    {
        Sessions.Changed += OnSessionsChanged;
        SyncActiveIndex();
        _ = RefreshDatabasesAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_lastIndex != _activeIndex && _activeIndex >= 0 && _activeIndex < Sessions.Tabs.Count)
        {
            _lastIndex = _activeIndex;
            Sessions.ActivateTab(Sessions.Tabs[_activeIndex].Id);
            _ = RefreshDatabasesAsync();
        }
    }

    private void OnSessionsChanged()
    {
        SyncActiveIndex();
        InvokeAsync(async () =>
        {
            await RefreshDatabasesAsync();
            StateHasChanged();
        });
    }

    private void SyncActiveIndex()
    {
        if (Sessions.ActiveTabId is null)
        {
            _activeIndex = 0;
            return;
        }

        var index = Sessions.Tabs.ToList().FindIndex(t => t.Id == Sessions.ActiveTabId);
        if (index >= 0)
        {
            _activeIndex = index;
        }
    }

    private async Task RefreshDatabasesAsync()
    {
        var tab = Sessions.ActiveTab;
        if (tab is null)
        {
            _databases = ["master"];
            return;
        }

        var connection = Sessions.OpenConnections.FirstOrDefault(c => c.Id == tab.ConnectionId)
                         ?? (await Store.GetAllAsync()).FirstOrDefault(c => c.Id == tab.ConnectionId);
        if (connection is null)
        {
            return;
        }

        try
        {
            var password = connection.UseWindowsAuth ? null : Store.DecryptPassword(connection);
            var provider = ProviderFactory.GetProvider(connection.Engine);
            var dbs = await provider.GetDatabasesAsync(connection, password);
            _databases = dbs.Select(d => d.Name).ToList();
            if (!_databases.Contains(tab.Database) && !string.IsNullOrWhiteSpace(tab.Database))
            {
                _databases.Insert(0, tab.Database);
            }
        }
        catch
        {
            if (!_databases.Contains(tab.Database))
            {
                _databases = [tab.Database];
            }
        }
    }

    private async Task OnDatabaseChanged(string database)
    {
        if (Sessions.ActiveTab is { } tab)
        {
            tab.Database = database;
            tab.Title = $"{(Sessions.OpenConnections.FirstOrDefault(c => c.Id == tab.ConnectionId)?.Name ?? "Query")} — {database}";
            Sessions.Notify();

            var connection = Sessions.OpenConnections.FirstOrDefault(c => c.Id == tab.ConnectionId)
                             ?? (await Store.GetAllAsync()).FirstOrDefault(c => c.Id == tab.ConnectionId);
            if (connection is not null)
            {
                _ = IntelliSense.EnsureAsync(connection, database);
            }
        }
    }

    private async Task RefreshIntelliSenseAsync()
    {
        var tab = Sessions.ActiveTab;
        if (tab is null)
        {
            Snackbar.Add("Open a query tab first.", Severity.Warning);
            return;
        }

        var connection = Sessions.OpenConnections.FirstOrDefault(c => c.Id == tab.ConnectionId)
                         ?? (await Store.GetAllAsync()).FirstOrDefault(c => c.Id == tab.ConnectionId);
        if (connection is null)
        {
            Snackbar.Add("Connect to a server first.", Severity.Warning);
            return;
        }

        Snackbar.Add("Refreshing IntelliSense…", Severity.Info);
        var snap = await IntelliSense.EnsureAsync(connection, tab.Database, forceRefresh: true);
        if (snap?.Status.StartsWith("Error") == true)
        {
            Snackbar.Add(snap.Status, Severity.Error);
        }
        else
        {
            Snackbar.Add(
                $"IntelliSense ready — {snap?.Databases.Count:N0} databases, {snap?.TableCount:N0} tables/views.",
                Severity.Success);
        }
    }

    private Task CloseTabAsync(Guid id) => CloseTabInternalAsync(id);

    public Task CloseActiveTabAsync()
    {
        var tab = Sessions.ActiveTab;
        return tab is null ? Task.CompletedTask : CloseTabInternalAsync(tab.Id);
    }

    private async Task CloseTabInternalAsync(Guid id)
    {
        var tab = Sessions.Tabs.FirstOrDefault(t => t.Id == id);
        if (tab is null)
        {
            return;
        }

        // Sync editor buffer before dirty check.
        tab.Sql = await Editors.GetSqlAsync(tab.Id) ?? tab.Sql;

        if (tab.IsDirty)
        {
            var choice = await DialogService.ShowMessageBoxAsync(
                "Unsaved changes",
                $"'{tab.Title}' has unsaved changes. Close anyway?",
                yesText: "Discard",
                cancelText: "Keep open");

            if (choice != true)
            {
                return;
            }
        }

        Sessions.CloseTab(id);
    }

    public async Task FormatActiveSqlAsync()
    {
        var tab = Sessions.ActiveTab;
        if (tab is null)
        {
            Snackbar.Add("Open a query tab first.", Severity.Warning);
            return;
        }

        var sql = await Editors.GetSqlAsync(tab.Id) ?? tab.Sql;
        var formatted = PSMS.Core.Sql.SqlFormatter.Format(sql);
        tab.Sql = formatted;
        tab.IsDirty = true;
        await Editors.SetSqlAsync(tab.Id, formatted);
        Sessions.Notify();
        Snackbar.Add("SQL formatted.", Severity.Info);
    }

    public async Task ExecuteActiveAsync()
    {
        await RunAsync(PlanKind.None);
    }

    public async Task ExecuteEstimatedPlanAsync()
    {
        await RunAsync(PlanKind.Estimated);
    }

    public async Task ExecuteActualPlanAsync()
    {
        await RunAsync(PlanKind.Actual);
    }

    private enum PlanKind { None, Estimated, Actual }

    private async Task RunAsync(PlanKind plan)
    {
        var tab = Sessions.ActiveTab;
        if (tab is null)
        {
            Snackbar.Add("Open a query tab first (New Query).", Severity.Warning);
            return;
        }

        var connection = Sessions.OpenConnections.FirstOrDefault(c => c.Id == tab.ConnectionId)
                         ?? (await Store.GetAllAsync()).FirstOrDefault(c => c.Id == tab.ConnectionId);

        if (connection is null)
        {
            Snackbar.Add("Connection not found. Reconnect from Object Explorer.", Severity.Warning);
            return;
        }

        var sql = await Editors.GetSelectedOrAllSqlAsync(tab.Id) ?? tab.Sql;
        tab.Sql = await Editors.GetSqlAsync(tab.Id) ?? tab.Sql;

        if (string.IsNullOrWhiteSpace(sql))
        {
            Snackbar.Add("Nothing to execute.", Severity.Warning);
            return;
        }

        tab.IsExecuting = true;
        Sessions.ViewLiveResults();
        Sessions.Notify();

        try
        {
            tab.LastResult = plan switch
            {
                PlanKind.Estimated => await QueryRunner.ExecuteEstimatedPlanAsync(connection, tab.Database, sql),
                PlanKind.Actual => await QueryRunner.ExecuteActualPlanAsync(connection, tab.Database, sql),
                _ => await QueryRunner.ExecuteAsync(connection, tab.Database, sql)
            };

            if (plan == PlanKind.None)
            {
                await History.AddAsync(new QueryHistoryEntry
                {
                    Sql = sql,
                    ConnectionId = connection.Id,
                    ConnectionName = connection.Name,
                    Database = tab.Database,
                    ElapsedMilliseconds = tab.LastResult.ElapsedMilliseconds,
                    Succeeded = string.IsNullOrEmpty(tab.LastResult.Error),
                    RowCount = tab.LastResult.ResultSets.Sum(r => r.Rows.Count),
                    Error = tab.LastResult.Error
                });
            }

            if (!string.IsNullOrEmpty(tab.LastResult.Error) && tab.LastResult.Error != "Cancelled")
            {
                Snackbar.Add(tab.LastResult.Error, Severity.Error);
            }
            else if (tab.LastResult.Error == "Cancelled")
            {
                Snackbar.Add("Query cancelled.", Severity.Info);
            }
            else if (string.IsNullOrEmpty(tab.LastResult.Error))
            {
                var rows = tab.LastResult.ResultSets.Sum(r => r.Rows.Count);
                Snackbar.Add(
                    plan switch
                    {
                        PlanKind.Estimated => $"Estimated plan — {rows:N0} plan row(s).",
                        PlanKind.Actual => $"Actual plan — {rows:N0} row(s) (query executed).",
                        _ => $"Query completed — {rows:N0} row(s)."
                    },
                    Severity.Success);
            }
        }
        catch (Exception ex)
        {
            tab.LastResult = new QueryResult { Error = ex.Message, Messages = [ex.Message] };
            if (plan == PlanKind.None)
            {
                await History.AddAsync(new QueryHistoryEntry
                {
                    Sql = sql,
                    ConnectionId = connection.Id,
                    ConnectionName = connection.Name,
                    Database = tab.Database,
                    Succeeded = false,
                    Error = ex.Message
                });
            }

            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            tab.IsExecuting = false;
            Sessions.Notify();
        }
    }

    public void Dispose() => Sessions.Changed -= OnSessionsChanged;
}

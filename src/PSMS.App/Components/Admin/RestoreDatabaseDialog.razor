@inject ISqlServerAdminService Admin
@inject IConnectionStore Store
@inject IFileDialogService FileDialogs
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Restore into <strong>@(_request.Database)</strong>. The .bak path must be readable by the
                <em>SQL Server service</em> (server disk or a UNC share), same as SSMS.
            </MudText>
            <MudTextField @bind-Value="_request.Database" Label="Target database" Required="true" />

            <MudText Typo="Typo.caption" Class="mud-text-secondary">Backup file</MudText>
            <div class="psms-path-row">
                <MudTextField @bind-Value="_request.BackupPath" Label="Backup path (.bak)" Required="true"
                              Class="psms-path-field"
                              HelperText="@_pathHint" />
            </div>
            <MudStack Row="true" Spacing="1" Class="flex-wrap">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Dns"
                           Disabled="_busy" OnClick="BrowseServerAsync">Browse server…</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FolderOpen"
                           Disabled="_busy" OnClick="BrowseLocalAsync">Browse local…</MudButton>
            </MudStack>

            @if (_recent.Count > 0)
            {
                <MudSelect T="string" Label="Recent backups on this server" Dense="true" Margin="Margin.Dense"
                           Value="_pickedRecent" ValueChanged="OnRecentChanged" Disabled="_busy"
                           HelperText="From msdb backup history">
                    <MudSelectItem T="string" Value="@string.Empty">(pick a recent backup)</MudSelectItem>
                    @foreach (var b in _recent)
                    {
                        var path = b.PhysicalDeviceName ?? string.Empty;
                        if (string.IsNullOrWhiteSpace(path))
                        {
                            continue;
                        }

                        <MudSelectItem T="string" Value="@path">
                            @($"{b.BackupStartDate.LocalDateTime:g} · {b.Name} · {path}")
                        </MudSelectItem>
                    }
                </MudSelect>
            }

            <MudCheckBox @bind-Value="_request.Replace" Label="REPLACE existing database (kicks users)" Color="Color.Warning" />
            <MudCheckBox @bind-Value="_request.Recover" Label="RECOVERY (bring online)" Color="Color.Primary" />
            @if (_messages.Count > 0)
            {
                <MudPaper Class="pa-2" Style="max-height:160px;overflow:auto;background:var(--psms-panel-2)">
                    @foreach (var m in _messages)
                    {
                        <MudText Typo="Typo.caption" Style="font-family:var(--psms-mono)">@m</MudText>
                    }
                </MudPaper>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Color="Color.Warning" Variant="Variant.Filled" OnClick="RunAsync"
                   Disabled="_busy || string.IsNullOrWhiteSpace(_request.Database) || string.IsNullOrWhiteSpace(_request.BackupPath)">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Restore
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ConnectionDefinition Connection { get; set; } = new();
    [Parameter] public string? Database { get; set; }
    [Parameter] public string? BackupPath { get; set; }

    private readonly RestoreDatabaseRequest _request = new() { Replace = true };
    private readonly List<string> _messages = [];
    private readonly List<BackupSetInfo> _recent = [];
    private string _pickedRecent = string.Empty;
    private string _pathHint = "Use Browse server for files on the SQL host, or Browse local if SQL can read that path (local instance / UNC).";
    private bool _busy;
    private string? _defaultBackupDir;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Database))
        {
            _request.Database = Database;
        }

        if (!string.IsNullOrWhiteSpace(BackupPath))
        {
            _request.BackupPath = BackupPath;
        }

        try
        {
            var password = Connection.UseWindowsAuth ? null : Store.DecryptPassword(Connection);
            _defaultBackupDir = await Admin.GetDefaultBackupDirectoryAsync(Connection, password);
            if (string.IsNullOrWhiteSpace(_request.BackupPath) && !string.IsNullOrWhiteSpace(_defaultBackupDir))
            {
                var sep = _defaultBackupDir.Contains('/') && !_defaultBackupDir.Contains('\\') ? "/" : "\\";
                _request.BackupPath = _defaultBackupDir.TrimEnd('\\', '/') + sep;
            }

            var recent = await Admin.GetRecentBackupsAsync(Connection, password, string.IsNullOrWhiteSpace(_request.Database) ? null : _request.Database);
            _recent.AddRange(recent.Where(b => !string.IsNullOrWhiteSpace(b.PhysicalDeviceName)));
        }
        catch
        {
            // optional
        }
    }

    private Task OnRecentChanged(string path)
    {
        _pickedRecent = path;
        if (!string.IsNullOrWhiteSpace(path))
        {
            _request.BackupPath = path;
            _pathHint = "Selected from recent server backups (msdb).";
        }

        return Task.CompletedTask;
    }

    private async Task BrowseServerAsync()
    {
        var parameters = new DialogParameters<ServerPathBrowserDialog>
        {
            { x => x.Connection, Connection },
            { x => x.InitialPath, string.IsNullOrWhiteSpace(_request.BackupPath) ? _defaultBackupDir : ParentDir(_request.BackupPath) },
            { x => x.FilesOnlyBak, true }
        };

        var dialog = await DialogService.ShowAsync<ServerPathBrowserDialog>(
            "Browse SQL Server",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string path } && !string.IsNullOrWhiteSpace(path))
        {
            _request.BackupPath = path;
            _pickedRecent = string.Empty;
            _pathHint = "Path on the SQL Server host.";
        }
    }

    private async Task BrowseLocalAsync()
    {
        var path = await FileDialogs.OpenBackupFileAsync();
        if (string.IsNullOrWhiteSpace(path))
        {
            return;
        }

        _request.BackupPath = path;
        _pickedRecent = string.Empty;
        _pathHint = "Local path — SQL Server must be able to read it (same machine or UNC share).";
        Snackbar.Add("Local file selected. Restore only works if the SQL Server service can read this path.", Severity.Info);
    }

    private static string? ParentDir(string path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return null;
        }

        var trimmed = path.TrimEnd('\\', '/');
        var slash = trimmed.Contains('/') && !trimmed.Contains('\\') ? '/' : '\\';
        var idx = trimmed.LastIndexOf(slash);
        if (idx <= 0)
        {
            return null;
        }

        var parent = trimmed[..idx];
        if (parent.Length == 2 && parent[1] == ':')
        {
            return parent + "\\";
        }

        return parent;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task RunAsync()
    {
        _busy = true;
        _messages.Clear();
        StateHasChanged();
        try
        {
            var password = Connection.UseWindowsAuth ? null : Store.DecryptPassword(Connection);
            var result = await Admin.RestoreDatabaseAsync(Connection, password, _request);
            _messages.AddRange(result.Messages);
            if (result.Succeeded)
            {
                Snackbar.Add($"{result.Message} ({result.ElapsedMilliseconds} ms)", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(result.Error ?? "Restore failed.", Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }
}

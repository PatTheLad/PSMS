@inject ISqlServerAdminService Admin
@inject IConnectionStore Store
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Creates a new database on <strong>@Connection.Name</strong> (@Connection.Server).
            </MudText>
            <MudTextField @bind-Value="_request.Name" Label="Database name" Required="true" Immediate="true" />
            <MudSelect T="string" @bind-Value="_request.RecoveryModel" Label="Recovery model">
                <MudSelectItem Value="@("SIMPLE")">SIMPLE</MudSelectItem>
                <MudSelectItem Value="@("FULL")">FULL</MudSelectItem>
                <MudSelectItem Value="@("BULK_LOGGED")">BULK_LOGGED</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_request.Collation" Label="Collation (optional)" HelperText="Leave blank for server default" />
            <MudNumericField T="int" @bind-Value="_request.InitialDataSizeMb" Label="Initial data size (MB)" Min="1" Max="102400" />
            <MudNumericField T="int" @bind-Value="_request.InitialLogSizeMb" Label="Initial log size (MB)" Min="1" Max="102400" />
            @if (_messages.Count > 0)
            {
                <MudPaper Class="pa-2" Style="max-height:140px;overflow:auto;background:var(--psms-panel-2)">
                    @foreach (var m in _messages)
                    {
                        <MudText Typo="Typo.caption" Style="font-family:var(--psms-mono)">@m</MudText>
                    }
                </MudPaper>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CreateAsync" Disabled="_busy || string.IsNullOrWhiteSpace(_request.Name)">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Create
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ConnectionDefinition Connection { get; set; } = new();

    private readonly CreateDatabaseRequest _request = new();
    private readonly List<string> _messages = [];
    private bool _busy;

    private void Cancel() => MudDialog.Cancel();

    private async Task CreateAsync()
    {
        _busy = true;
        _messages.Clear();
        try
        {
            var password = Connection.UseWindowsAuth ? null : Store.DecryptPassword(Connection);
            var result = await Admin.CreateDatabaseAsync(Connection, password, _request);
            _messages.AddRange(result.Messages);
            if (result.Succeeded)
            {
                Snackbar.Add(result.Message ?? "Database created.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(_request.Name));
            }
            else
            {
                Snackbar.Add(result.Error ?? "Create failed.", Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }
}

    private Task ScriptCountAsync(ConnectionDefinition connection, string database, string schema, string table)
    {
        var qualified = Qualify(connection.Engine, schema, table);
        var sql = $"SELECT COUNT(*) AS [RowCount]{System.Environment.NewLine}FROM {qualified};";
        if (connection.Engine != DbEngine.SqlServer)
        {
            sql = $"SELECT COUNT(*) AS RowCount{System.Environment.NewLine}FROM {qualified};";
        }

        return NewQuery(connection, database, sql, $"COUNT {schema}.{table}");
    }

    private async Task ScriptInsertAsync(ConnectionDefinition connection, string database, string schema, string table)
    {
        try
        {
            var password = connection.UseWindowsAuth ? null : Store.DecryptPassword(connection);
            var provider = ProviderFactory.GetProvider(connection.Engine);
            var columns = await provider.GetColumnsAsync(connection, password, database, schema, table);
            var colNames = columns.Select(c => QuoteIdent(connection.Engine, c.Name)).ToList();
            if (colNames.Count == 0)
            {
                Snackbar.Add("No columns found for INSERT script.", Severity.Warning);
                return;
            }

            var qualified = Qualify(connection.Engine, schema, table);
            var nl = System.Environment.NewLine;
            var sql =
                $"INSERT INTO {qualified} ({string.Join(", ", colNames)}){nl}" +
                $"VALUES ({string.Join(", ", colNames.Select(_ => "NULL"))});";
            await NewQuery(connection, database, sql, $"INSERT {schema}.{table}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ScriptInsertSelectAsync(ConnectionDefinition connection, string database, string schema, string table)
    {
        try
        {
            var password = connection.UseWindowsAuth ? null : Store.DecryptPassword(connection);
            var provider = ProviderFactory.GetProvider(connection.Engine);
            var columns = await provider.GetColumnsAsync(connection, password, database, schema, table);
            var colNames = columns.Select(c => QuoteIdent(connection.Engine, c.Name)).ToList();
            if (colNames.Count == 0)
            {
                Snackbar.Add("No columns found for INSERT…SELECT script.", Severity.Warning);
                return;
            }

            var qualified = Qualify(connection.Engine, schema, table);
            var nl = System.Environment.NewLine;
            var list = string.Join(", ", colNames);
            var sql =
                $"INSERT INTO {qualified} ({list}){nl}" +
                $"SELECT {list}{nl}" +
                $"FROM {qualified}{nl}" +
                $"WHERE 1 = 0; -- template";
            await NewQuery(connection, database, sql, $"INSERT SELECT {schema}.{table}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private Task ScriptAlterTableAsync(ConnectionDefinition connection, string database, string schema, string table)
    {
        var qualified = Qualify(connection.Engine, schema, table);
        var nl = System.Environment.NewLine;
        var sql = connection.Engine == DbEngine.SqlServer
            ? $"ALTER TABLE {qualified}{nl}ADD /* column_name datatype NULL */;{nl}-- ALTER TABLE {qualified} DROP COLUMN /* column_name */;"
            : $"ALTER TABLE {qualified}{nl}ADD COLUMN /* column_name TYPE */;{nl}-- ALTER TABLE {qualified} DROP COLUMN /* column_name */;";
        return NewQuery(connection, database, sql, $"ALTER {schema}.{table}");
    }

    private Task ScriptDropAsync(ConnectionDefinition connection, string database, string schema, string name, string objectType)
    {
        var qualified = Qualify(connection.Engine, schema, name);
        var sql = $"DROP {objectType} {qualified};";
        return NewQuery(connection, database, sql, $"DROP {schema}.{name}");
    }

    private Task ScriptIndexCreateAsync(ConnectionDefinition connection, string database, string schema, string table, IndexInfo index)
    {
        var tableQ = Qualify(connection.Engine, schema, table);
        var ixName = QuoteIdent(connection.Engine, index.Name);
        var cols = string.Join(", ",
            index.Columns.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(c => QuoteIdent(connection.Engine, c)));
        string sql;
        if (index.IsPrimaryKey)
        {
            sql = $"ALTER TABLE {tableQ} ADD CONSTRAINT {ixName} PRIMARY KEY ({cols});";
        }
        else if (connection.Engine == DbEngine.SqlServer)
        {
            var unique = index.IsUnique ? "UNIQUE " : "";
            sql = $"CREATE {unique}INDEX {ixName} ON {tableQ} ({cols});";
        }
        else
        {
            var unique = index.IsUnique ? "UNIQUE " : "";
            sql = $"CREATE {unique}INDEX {ixName} ON {tableQ} ({cols});";
        }

        return NewQuery(connection, database, sql, $"CREATE INDEX {index.Name}");
    }

    private Task ScriptIndexDropAsync(ConnectionDefinition connection, string database, string schema, string table, IndexInfo index)
    {
        var tableQ = Qualify(connection.Engine, schema, table);
        var ixName = QuoteIdent(connection.Engine, index.Name);
        var sql = connection.Engine == DbEngine.SqlServer
            ? (index.IsPrimaryKey
                ? $"ALTER TABLE {tableQ} DROP CONSTRAINT {ixName};"
                : $"DROP INDEX {ixName} ON {tableQ};")
            : $"DROP INDEX IF EXISTS {ixName};";
        return NewQuery(connection, database, sql, $"DROP INDEX {index.Name}");
    }

    private Task ScriptForeignKeyCreateAsync(ConnectionDefinition connection, string database, string schema, string table, ForeignKeyInfo fk)
    {
        var tableQ = Qualify(connection.Engine, schema, table);
        var fkName = QuoteIdent(connection.Engine, fk.Name);
        var cols = string.Join(", ",
            fk.Columns.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(c => QuoteIdent(connection.Engine, c)));
        var refTable = Qualify(connection.Engine, fk.ReferencedSchema, fk.ReferencedTable);
        var refCols = string.Join(", ",
            fk.ReferencedColumns.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(c => QuoteIdent(connection.Engine, c)));
        var sql = $"ALTER TABLE {tableQ} ADD CONSTRAINT {fkName} FOREIGN KEY ({cols}) REFERENCES {refTable} ({refCols});";
        return NewQuery(connection, database, sql, $"CREATE FK {fk.Name}");
    }

    private Task ScriptForeignKeyDropAsync(ConnectionDefinition connection, string database, string schema, string table, ForeignKeyInfo fk)
    {
        var tableQ = Qualify(connection.Engine, schema, table);
        var fkName = QuoteIdent(connection.Engine, fk.Name);
        var sql = connection.Engine == DbEngine.SqlServer
            ? $"ALTER TABLE {tableQ} DROP CONSTRAINT {fkName};"
            : $"ALTER TABLE {tableQ} DROP CONSTRAINT {fkName};";
        return NewQuery(connection, database, sql, $"DROP FK {fk.Name}");
    }

    private Task ScriptExecAsync(ConnectionDefinition connection, string database, string schema, string proc)
    {
        var sql = connection.Engine == DbEngine.SqlServer
            ? $"EXEC [{schema}].[{proc}];"
            : $"CALL {Qualify(connection.Engine, schema, proc)};";
        return NewQuery(connection, database, sql, proc);
    }

    private static string BuildSelectTopSql(DbEngine engine, string schema, string table)
    {
        var qualified = Qualify(engine, schema, table);
        return engine switch
        {
            DbEngine.SqlServer => $"SELECT TOP (1000) *{System.Environment.NewLine}FROM {qualified};",
            _ => $"SELECT *{System.Environment.NewLine}FROM {qualified}{System.Environment.NewLine}LIMIT 1000;"
        };
    }

    private static string Qualify(DbEngine engine, string schema, string name) =>
        engine == DbEngine.SqlServer
            ? $"[{schema}].[{name}]"
            : string.IsNullOrWhiteSpace(schema) || schema is "main" or "dbo"
                ? QuoteIdent(engine, name)
                : $"{QuoteIdent(engine, schema)}.{QuoteIdent(engine, name)}";

    private static string QuoteIdent(DbEngine engine, string ident) =>
        engine == DbEngine.SqlServer ? $"[{ident}]" : $"\"{ident.Replace("\"", "\"\"")}\"";


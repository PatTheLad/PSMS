@using System.Runtime.InteropServices
@using System.Text.RegularExpressions
@inject IConnectionStore Store
@inject IDbProviderFactory ProviderFactory
@inject ActiveSessionService Sessions
@inject IFileDialogService FileDialogs
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="_model.Name" Label="Connection name" Required="true" />
            <div class="psms-color-picker">
                <MudText Typo="Typo.caption" Class="mb-1">Connection color</MudText>
                <div class="psms-color-swatches">
                    <button type="button" class="psms-color-swatch none @(_model.Color is null ? "active" : null)"
                            title="None" @onclick="@(() => _model.Color = null)"></button>
                    @foreach (var hex in PresetColors)
                    {
                        <button type="button"
                                class="psms-color-swatch @(string.Equals(_model.Color, hex, StringComparison.OrdinalIgnoreCase) ? "active" : null)"
                                style="@($"background:{hex}")"
                                title="@hex"
                                @onclick="@(() => _model.Color = hex)"></button>
                    }
                </div>
            </div>
            <MudSelect T="DbEngine" @bind-Value="_model.Engine" Label="Engine" Dense="true">
                <MudSelectItem Value="DbEngine.SqlServer">SQL Server</MudSelectItem>
                <MudSelectItem Value="DbEngine.Sqlite">SQLite</MudSelectItem>
                @if (RuntimeInformation.IsOSPlatform(OSPlatform.Windows))
                {
                    <MudSelectItem Value="DbEngine.Access">Access</MudSelectItem>
                }
            </MudSelect>

            @if (_model.Engine == DbEngine.SqlServer)
            {
                <MudExpansionPanels Elevation="0" Class="psms-conn-expand">
                    <MudExpansionPanel Text="Paste connection string" Dense="true" @bind-Expanded="_showConnString">
                        <MudTextField @bind-Value="_connectionString"
                                      Label="ADO.NET connection string"
                                      Lines="3"
                                      HelperText="Server / Data Source, Initial Catalog, User Id, Password, Encrypt, TrustServerCertificate, Integrated Security" />
                        <MudButton Class="mt-2" Size="Size.Small" Variant="Variant.Outlined"
                                   OnClick="ApplyConnectionString" Disabled="_busy">Apply</MudButton>
                    </MudExpansionPanel>
                </MudExpansionPanels>

                <MudTextField @bind-Value="_model.Server" Label="Server" Required="true" HelperText="e.g. localhost or .\SQLEXPRESS" />
                <MudNumericField T="int?" @bind-Value="_model.Port" Label="Port (optional)" Min="1" Max="65535" />
                <MudTextField @bind-Value="_model.Database" Label="Default database" HelperText="Optional; defaults to master" />
                <MudSwitch @bind-Value="_model.UseWindowsAuth" Label="@AuthLabel" Color="Color.Primary" />
                @if (!_model.UseWindowsAuth)
                {
                    <MudTextField @bind-Value="_model.UserName" Label="Login" Required="true" />
                    <MudTextField @bind-Value="_password" Label="Password" InputType="InputType.Password"
                                  HelperText="Leave blank when editing to keep the stored password" />
                }
                <MudSwitch @bind-Value="_model.Encrypt" Label="Encrypt" Color="Color.Primary" />
                <MudSwitch @bind-Value="_model.TrustServerCertificate" Label="Trust server certificate" Color="Color.Primary" />
            }
            else
            {
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudTextField @bind-Value="_model.Database" Label="Database file path" Required="true" Class="flex-grow-1"
                                  HelperText="@(_model.Engine == DbEngine.Sqlite ? "Path to .db / .sqlite file" : "Path to .accdb / .mdb file")" />
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.FolderOpen"
                               OnClick="BrowseDatabaseFileAsync"
                               Disabled="_busy">Browse…</MudButton>
                </MudStack>
                <MudTextField @bind-Value="_model.Server" Label="Display / alternate path (optional)" />
                @if (_model.Engine == DbEngine.Access)
                {
                    <MudTextField @bind-Value="_password" Label="Database password (optional)" InputType="InputType.Password" />
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="TestAsync" Disabled="_busy">Test</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_busy">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ConnectionDefinition Connection { get; set; } = new();

    private static readonly string[] PresetColors =
    [
        "#3b9eff", "#ef4444", "#f59e0b", "#22c55e",
        "#a855f7", "#ec4899", "#14b8a6", "#94a3b8"
    ];

    private ConnectionDefinition _model = new();
    private string? _password;
    private string _connectionString = string.Empty;
    private bool _showConnString;
    private bool _busy;

    private string AuthLabel => RuntimeInformation.IsOSPlatform(OSPlatform.Windows)
        ? "Windows authentication"
        : "Integrated authentication (Windows only — use SQL login on Linux/macOS)";

    protected override void OnInitialized()
    {
        _model = new ConnectionDefinition
        {
            Id = Connection.Id,
            Name = string.IsNullOrWhiteSpace(Connection.Name) ? "SQL Server" : Connection.Name,
            Engine = Connection.Engine,
            Server = Connection.Server,
            Database = Connection.Database,
            UseWindowsAuth = Connection.UseWindowsAuth && RuntimeInformation.IsOSPlatform(OSPlatform.Windows),
            UserName = Connection.UserName,
            EncryptedPassword = Connection.EncryptedPassword,
            Encrypt = Connection.Encrypt,
            TrustServerCertificate = Connection.TrustServerCertificate,
            Port = Connection.Port,
            Color = Connection.Color
        };

        if (!RuntimeInformation.IsOSPlatform(OSPlatform.Windows))
        {
            _model.UseWindowsAuth = false;
            if (_model.Engine == DbEngine.Access)
            {
                _model.Engine = DbEngine.SqlServer;
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task BrowseDatabaseFileAsync()
    {
        var path = await FileDialogs.OpenDatabaseFileAsync(_model.Engine == DbEngine.Access);
        if (string.IsNullOrWhiteSpace(path))
        {
            return;
        }

        _model.Database = path;
        if (string.IsNullOrWhiteSpace(_model.Name) || _model.Name is "SQL Server" or "SQLite" or "Access")
        {
            _model.Name = Path.GetFileNameWithoutExtension(path);
        }

        if (string.IsNullOrWhiteSpace(_model.Server))
        {
            _model.Server = path;
        }
    }

    private void ApplyConnectionString()
    {
        if (string.IsNullOrWhiteSpace(_connectionString))
        {
            Snackbar.Add("Paste a connection string first.", Severity.Warning);
            return;
        }

        try
        {
            var map = ParseConnectionString(_connectionString);
            if (map.TryGetValue("data source", out var ds) || map.TryGetValue("server", out ds) || map.TryGetValue("addr", out ds) || map.TryGetValue("address", out ds))
            {
                var (server, port) = SplitServerPort(ds);
                _model.Server = server;
                if (port is not null)
                {
                    _model.Port = port;
                }
            }

            if (map.TryGetValue("initial catalog", out var db) || map.TryGetValue("database", out db))
            {
                _model.Database = db;
            }

            var integrated = map.TryGetValue("integrated security", out var integ)
                             && IsTruthy(integ);
            var trusted = map.TryGetValue("trusted_connection", out var tc) && IsTruthy(tc);
            _model.UseWindowsAuth = (integrated || trusted) && RuntimeInformation.IsOSPlatform(OSPlatform.Windows);

            if (map.TryGetValue("user id", out var user) || map.TryGetValue("uid", out user) || map.TryGetValue("user", out user))
            {
                _model.UserName = user;
                if (!string.IsNullOrWhiteSpace(user))
                {
                    _model.UseWindowsAuth = false;
                }
            }

            if (map.TryGetValue("password", out var pwd) || map.TryGetValue("pwd", out pwd))
            {
                _password = pwd;
                _model.UseWindowsAuth = false;
            }

            if (map.TryGetValue("encrypt", out var enc))
            {
                _model.Encrypt = IsTruthy(enc);
            }

            if (map.TryGetValue("trustservercertificate", out var tsc) || map.TryGetValue("trust server certificate", out tsc))
            {
                _model.TrustServerCertificate = IsTruthy(tsc);
            }

            if (string.IsNullOrWhiteSpace(_model.Name) || _model.Name == "SQL Server")
            {
                _model.Name = string.IsNullOrWhiteSpace(_model.Database)
                    ? _model.Server
                    : $"{_model.Server} / {_model.Database}";
            }

            Snackbar.Add("Connection string applied to fields.", Severity.Success);
            _showConnString = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not parse connection string: {ex.Message}", Severity.Error);
        }
    }

    private static Dictionary<string, string> ParseConnectionString(string raw)
    {
        var map = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (Match m in Regex.Matches(raw, @"(?:^|;)\s*([^=;]+)\s*=\s*(""[^""]*""|[^;]*)", RegexOptions.CultureInvariant))
        {
            var key = m.Groups[1].Value.Trim();
            var value = m.Groups[2].Value.Trim();
            if (value.Length >= 2 && value[0] == '"' && value[^1] == '"')
            {
                value = value[1..^1];
            }

            if (!string.IsNullOrWhiteSpace(key))
            {
                map[key] = value;
            }
        }

        return map;
    }

    private static (string Server, int? Port) SplitServerPort(string dataSource)
    {
        var value = dataSource.Trim();
        // tcp:host,1433 or host,1433
        value = Regex.Replace(value, @"^tcp:", "", RegexOptions.IgnoreCase);
        var comma = value.LastIndexOf(',');
        if (comma > 0 && int.TryParse(value[(comma + 1)..].Trim(), out var port) && port is > 0 and <= 65535)
        {
            return (value[..comma].Trim(), port);
        }

        return (value, null);
    }

    private static bool IsTruthy(string value) =>
        value.Equals("true", StringComparison.OrdinalIgnoreCase)
        || value.Equals("yes", StringComparison.OrdinalIgnoreCase)
        || value.Equals("sspi", StringComparison.OrdinalIgnoreCase)
        || value == "1";

    private async Task TestAsync()
    {
        _busy = true;
        try
        {
            var password = ResolvePasswordForUse();
            var provider = ProviderFactory.GetProvider(_model.Engine);
            await provider.TestConnectionAsync(_model, password);
            Snackbar.Add("Connection succeeded.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Connection failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            Snackbar.Add("Name is required.", Severity.Warning);
            return;
        }

        if (_model.Engine == DbEngine.SqlServer)
        {
            if (string.IsNullOrWhiteSpace(_model.Server))
            {
                Snackbar.Add("Server is required.", Severity.Warning);
                return;
            }

            if (!_model.UseWindowsAuth && string.IsNullOrWhiteSpace(_model.UserName))
            {
                Snackbar.Add("Login is required for SQL authentication.", Severity.Warning);
                return;
            }
        }
        else if (string.IsNullOrWhiteSpace(_model.Database) && string.IsNullOrWhiteSpace(_model.Server))
        {
            Snackbar.Add("Database file path is required.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            if (_model.Engine != DbEngine.SqlServer)
            {
                _model.UseWindowsAuth = false;
                if (string.IsNullOrWhiteSpace(_model.Server) && !string.IsNullOrWhiteSpace(_model.Database))
                {
                    _model.Server = _model.Database;
                }
            }

            await Store.SaveAsync(_model, _model.UseWindowsAuth ? null : _password);
            Sessions.NotifyConnectionsChanged();
            Snackbar.Add("Connection saved.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(_model));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private string? ResolvePasswordForUse()
    {
        if (_model.UseWindowsAuth)
        {
            return null;
        }

        if (!string.IsNullOrEmpty(_password))
        {
            return _password;
        }

        return Store.DecryptPassword(_model);
    }
}
